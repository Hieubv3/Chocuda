# 2. Tên miền / URL chính thức ứng dụng
APP_URL="https://chocudan24h.com"

# 3. Google OAuth Client ID (Dành cho Đăng nhập bằng Google)
VITE_GOOGLE_CLIENT_ID="676805214069-67li6kv4ppmc1jmff5u29lcns84idk6a.apps.googleusercontent.com"

# 4. Facebook App ID & App Secret (Dành cho Facebook Login & Meta Developer Review)
VITE_FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# 5. Cấu hình gửi Email OTP thật qua Gmail SMTP (Google App Password)
GMAIL_USER="chocudan24h@gmail.com"
GMAIL_APP_PASS="" # Mật khẩu ứng dụng Google 16 ký tự (Tạo tại myaccount.google.com -> Security -> App Passwords)

# ==========================================
# CẤU HÌNH THANH TOÁN ONLINE
# ==========================================

# 6. VNPay Configuration (https://sandbox.vnpayment.vn)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
