# 9. Payment Mode: 'sandbox' or 'production'
PAYMENT_MODE="sandbox"

# ==========================================
# CẤU HÌNH WEBHOOK & BẢO MẬT
# ==========================================

# 10. Webhook Secret for Payment Intermediaries (SePay, Casso, etc.)
